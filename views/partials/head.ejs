<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= typeof title !== 'undefined' ? title : 'Comedor de los Pobres' %></title>
<meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Asociación Juan XXIII - Comedor de los Pobres P. Roberto Infante en Nuevo León.' %>">
<link rel="icon" type="image/png" href="/imagenes/logomorado.png">

<!-- ----- SEO & Social Sharing (OpenGraph & Twitter) ----- -->
<meta property="og:type" content="website">
<meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'Comedor de los Pobres' %>">
<meta property="og:description" content="<%= typeof description !== 'undefined' ? description : 'Asociación Juan XXIII - Comedor de los Pobres P. Roberto Infante en Nuevo León.' %>">
<meta property="og:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : '/imagenes/logomorado.png' %>">
<% if (typeof ogUrl !== 'undefined' && ogUrl) { %>
<meta property="og:url" content="<%= ogUrl %>">
<% } %>

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'Comedor de los Pobres' %>">
<meta name="twitter:description" content="<%= typeof description !== 'undefined' ? description : 'Asociación Juan XXIII - Comedor de los Pobres P. Roberto Infante en Nuevo León.' %>">
<meta name="twitter:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : '/imagenes/logomorado.png' %>">

<!-- Preconnect: acelera DNS lookup de fuentes e iconos -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://cdnjs.cloudflare.com">

<!--
    CSS compilado (Tailwind v3 purgeado + estilos globales).
    Reemplaza el CDN de Tailwind que bloqueaba el main thread al cargar.
    Para regenerar: npm run build:css
-->
<link rel="stylesheet" href="/css/styles.css">

<!-- Google Fonts via <link> (evita el serial @import que causaba demoras) -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,700;0,800;1,800&display=swap" rel="stylesheet">

<!-- Font Awesome -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
